# Validates entry,exit_block,direct_target[,return_block...]. Every descriptor
# is exactly 0x followed by 16 lowercase hexadecimal digits. Empty disables.
function(dynarmic_js_validate_a64_region_focus text out_var)
    set(valid FALSE)
    if ("${text}" STREQUAL "")
        set(valid TRUE)
    else()
        set(hex "[0-9a-f]")
        set(descriptor "0x${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}${hex}")
        string(REGEX MATCH "^${descriptor},${descriptor},${descriptor}(,${descriptor})*$" matched "${text}")
        if ("${matched}" STREQUAL "${text}")
            set(valid TRUE)
            string(REPLACE "," ";" fields "${text}")
            list(LENGTH fields field_count)
            set(index 3)
            set(previous "")
            while (index LESS field_count)
                list(GET fields ${index} current)
                if (index GREATER 3 AND NOT "${current}" STRGREATER "${previous}")
                    set(valid FALSE)
                endif()
                set(previous "${current}")
                math(EXPR index "${index} + 1")
            endwhile()
        endif()
    endif()
    set(${out_var} ${valid} PARENT_SCOPE)
endfunction()
