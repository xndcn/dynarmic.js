diff --git a/src/dynarmic/backend/wasm/emit_wasm_self_loop.cpp b/src/dynarmic/backend/wasm/emit_wasm_self_loop.cpp
index 58574bf..47361d6 100644
--- a/src/dynarmic/backend/wasm/emit_wasm_self_loop.cpp
+++ b/src/dynarmic/backend/wasm/emit_wasm_self_loop.cpp
@@ -645,6 +645,13 @@ void EmitBeginRegion(EmitContext& ctx) {
         ctx.code.LocalSet(region.next);
     }
 
+    // Ordinary returns keep their inline coherence barrier. Only tail calls
+    // leave through this result block; they pass the function-table index.
+    if (ctx.emit_conf.frontend == Frontend::A32 && ctx.emit_conf.boundary_state != nullptr && ctx.table_imported) {
+        ctx.code.Block({{ValType::I32}});
+        region.tail_exit_depth = ctx.code.Depth();
+    }
+
     const u32 n = static_cast<u32>(region.blocks.size());
     region.label_depth.assign(n, 0);
     ctx.code.Loop();
@@ -725,9 +732,23 @@ void EmitEndRegionSelfLoop(EmitContext& ctx) {
 }
 
 void EmitEndRegion(EmitContext& ctx) {
-    TeardownRegisterCache(ctx);
     ctx.code.End();  // $dispatch
     ctx.code.U8(Op::Unreachable);
+    if (ctx.region.tail_exit_depth != 0) {
+        ctx.code.End();
+        if (ctx.region.tail_exit_used) {
+            const u32 target = ctx.code.AddLocals(1, ValType::I32);
+            ctx.code.LocalSet(target);
+            ctx.code.LocalGet(kParamState);
+            ctx.code.LocalGet(kParamEctx);
+            ctx.code.LocalGet(target);
+            const u32 type = ctx.Type({{ValType::I32, ValType::I32}, {ValType::I32}});
+            ctx.code.ReturnCallIndirect(type);
+        } else {
+            ctx.code.U8(Op::Unreachable);
+        }
+    }
+    TeardownRegisterCache(ctx);
 }
 
 }  // namespace Dynarmic::Backend::Wasm
